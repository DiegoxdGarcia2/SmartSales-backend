# Configuración de Producción - Variables de Entorno
# Copiar a .env.production y configurar valores reales

# Django Core
DJANGO_SECRET_KEY=tu-secret-key-super-seguro-aqui
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.run.app,localhost,127.0.0.1
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=True

# Base de Datos (Cloud SQL)
DATABASE_URL=postgresql://usuario:password@//cloudsql/tu-proyecto:region:instancia/dbname

# Stripe
STRIPE_SECRET_KEY=sk_live_tu_clave_secreta_de_stripe
STRIPE_PUBLISHABLE_KEY=pk_live_tu_clave_publica_de_stripe
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret
FRONTEND_CHECKOUT_SUCCESS_URL=https://tu-dominio.com/checkout/success?session_id={CHECKOUT_SESSION_ID}
FRONTEND_CHECKOUT_CANCEL_URL=https://tu-dominio.com/checkout/cancel

# Google AI (Gemini)
GOOGLE_AI_API_KEY=tu_api_key_de_google_ai

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Firebase (Push Notifications)
FIREBASE_CREDENTIALS_PATH=/secrets/firebase.json

# Email (opcional, para notificaciones por email)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password
DEFAULT_FROM_EMAIL=SmartSales <noreply@smartsales.com>

# Frontend
FRONTEND_URL=https://tu-dominio.com

# Opcionales
SENTRY_DSN=tu-sentry-dsn-para-logging
REDIS_URL=redis://tu-redis-url:6379